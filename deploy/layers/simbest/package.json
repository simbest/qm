{
  "name": "simbest-qm-deployment",
  "version": "0.0.0",
  "dependencies": {
    "@yc-software/qm": "0.1.4"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "qm": "qm",
    "check": "qm check",
    "plan": "qm plan",
    "deploy": "qm up",
    "status": "qm status",
    "conformance": "qm conformance --static",
    "build:sandbox-local": "docker build --platform linux/amd64 -f images/sandbox-local/Dockerfile -t simbest-sandbox:mvp-0.1.9 ../../..",
    "build:web-ui-source": "docker build --no-cache --progress=plain -f web-ui/Dockerfile -t simbest-web-ui:source ../../..",
    "build:web-ui-local": "docker build -f images/web-ui-local/Dockerfile -t simbest-web-ui-local:0.2.0 .",
    "build:web-ui": "npm run build:web-ui-source && npm run build:web-ui-local",
    "build:core-local": "docker build -f images/core-local/Dockerfile -t simbest-core-local:0.2.0 .",
    "build:admin-local": "docker build -f images/admin-local/Dockerfile -t simbest-admin-local:0.2.0 .",
    "test:gateway": "node --test test/glm-responses.test.mjs",
    "test": "node --test test/*.test.cjs test/*.test.mjs"
  }
}
